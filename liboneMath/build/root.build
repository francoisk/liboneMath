# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

# Space-separated list of include directories to be set (via `-isystem`) when
# compiling backend library code.
#
config [dir_paths] config.liboneMath.backend_incdirs

if ($build.mode != 'skeleton')
{
  if! $defined(config.liboneMath.backend_incdirs)
    fail "config.liboneMath.backend_incdirs is undefined"
}

# Backend-related config variables
#
config [bool] config.liboneMath.enable_armpl_backend ?= false
# config [bool] config.liboneMath.enable_armpl_openrng ?= false
config [bool] config.liboneMath.enable_cublas_backend ?= false
config [bool] config.liboneMath.enable_cufft_backend ?= false
config [bool] config.liboneMath.enable_curand_backend ?= false
config [bool] config.liboneMath.enable_cusolver_backend ?= false
config [bool] config.liboneMath.enable_cusparse_backend ?= false
config [bool] config.liboneMath.enable_mklcpu_backend ?= false
config [bool] config.liboneMath.enable_mklgpu_backend ?= false
config [bool] config.liboneMath.enable_netlib_backend ?= false
config [bool] config.liboneMath.enable_generic_blas_backend ?= false
# config [bool] config.liboneMath.enable_generic_blas_backend_amd_gpu ?= false
# config [bool] config.liboneMath.enable_generic_blas_backend_intel_cpu ?= false
# config [bool] config.liboneMath.enable_generic_blas_backend_intel_gpu ?= false
# config [bool] config.liboneMath.enable_generic_blas_backend_nvidia_gpu ?= false
# config [bool] config.liboneMath.generic_blas_enable_complex ?= false
# config [bool] config.liboneMath.generic_blas_enable_usm ?= false
config [bool] config.liboneMath.enable_portfft_backend ?= false
config [bool] config.liboneMath.enable_rocblas_backend ?= false
config [bool] config.liboneMath.enable_rocfft_backend ?= false
config [bool] config.liboneMath.enable_rocrand_backend ?= false
config [bool] config.liboneMath.enable_rocsolver_backend ?= false
config [bool] config.liboneMath.enable_rocsparse_backend ?= false
